{
  "manifest_version": 3,
  "name": "Bookmarks",
  "version": "0.1.0",
  "description": "Replaces the new tab page with a simple bookmarks bar grid.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
